<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>SpecialRatizens</AssemblyName>
    <RootNamespace>SpecialRatizens</RootNamespace>
    <Version>0.1.4</Version>
    <AssemblyVersion>0.1.4.0</AssemblyVersion>
    <FileVersion>0.1.4.0</FileVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);8321</NoWarn>
    <RatopiaDir Condition="'$(RatopiaDir)' == ''">$(RATOPIA_DIR)</RatopiaDir>
    <GameManagedDir>$(RatopiaDir)\Ratopia_Data\Managed</GameManagedDir>
    <BepInExCoreDir>$(RatopiaDir)\BepInEx\core</BepInExCoreDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp" HintPath="$(GameManagedDir)\Assembly-CSharp.dll" Private="false" />
    <Reference Include="Assembly-CSharp-firstpass" HintPath="$(GameManagedDir)\Assembly-CSharp-firstpass.dll" Private="false" />
    <Reference Include="BepInEx" HintPath="$(BepInExCoreDir)\BepInEx.dll" Private="false" />
    <Reference Include="0Harmony" HintPath="$(BepInExCoreDir)\0Harmony.dll" Private="false" />
    <Reference Include="LitJson" HintPath="$(GameManagedDir)\LitJson.dll" Private="false" />
    <Reference Include="Newtonsoft.Json" HintPath="$(GameManagedDir)\Newtonsoft.Json.dll" Private="false" />
    <Reference Include="spine-csharp" HintPath="$(GameManagedDir)\spine-csharp.dll" Private="false" />
    <Reference Include="Unity.InputSystem" HintPath="$(GameManagedDir)\Unity.InputSystem.dll" Private="false" />
    <Reference Include="Unity.TextMeshPro" HintPath="$(GameManagedDir)\Unity.TextMeshPro.dll" Private="false" />
    <Reference Include="UnityEngine" HintPath="$(GameManagedDir)\UnityEngine.dll" Private="false" />
    <Reference Include="UnityEngine.CoreModule" HintPath="$(GameManagedDir)\UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="UnityEngine.ImageConversionModule" HintPath="$(GameManagedDir)\UnityEngine.ImageConversionModule.dll" Private="false" />
    <Reference Include="UnityEngine.IMGUIModule" HintPath="$(GameManagedDir)\UnityEngine.IMGUIModule.dll" Private="false" />
    <Reference Include="UnityEngine.InputLegacyModule" HintPath="$(GameManagedDir)\UnityEngine.InputLegacyModule.dll" Private="false" />
    <Reference Include="UnityEngine.Physics2DModule" HintPath="$(GameManagedDir)\UnityEngine.Physics2DModule.dll" Private="false" />
    <Reference Include="UnityEngine.TextRenderingModule" HintPath="$(GameManagedDir)\UnityEngine.TextRenderingModule.dll" Private="false" />
    <Reference Include="UnityEngine.UI" HintPath="$(GameManagedDir)\UnityEngine.UI.dll" Private="false" />
    <Reference Include="UnityEngine.UIModule" HintPath="$(GameManagedDir)\UnityEngine.UIModule.dll" Private="false" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SpecialRatizens.Tests" />
  </ItemGroup>

  <Target Name="ValidateRatopiaReferences" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(GameManagedDir)\Assembly-CSharp.dll')" Text="找不到鼠托邦程序集。请通过 /p:RatopiaDir=游戏目录 指定正确路径。" />
    <Error Condition="!Exists('$(BepInExCoreDir)\BepInEx.dll')" Text="找不到 BepInEx 5。请确认 RatopiaDir 指向已安装 BepInEx 的游戏目录。" />
  </Target>
</Project>
